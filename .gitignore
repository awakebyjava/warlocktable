# Python bytecode cache — regenerated automatically on every run, never commit
__pycache__/
*.py[cod]

# Virtual environments — recreated from requirements, not shared between machines
.venv/
venv/
env/

# Audio assets — deliberately kept out of git.
# Large binaries can't be diffed or compressed, and every version is stored
# forever, so they bloat the repo permanently (this repo was ~1GB before).
# Master copies live outside the repo; sync to the Pi with rsync over SSH.
# If you ever genuinely need one tracked: git add -f <file>
*.wav
*.ogg
*.mp3
*.flac

# Runtime output from the fake-hardware CLI (warlock/cli.py) — this is a log
# of a dev session, not project data. data/config.example.json IS committed;
# only the log is excluded.
data/events.log

# Finished display artwork — same rule as audio, one order of magnitude down.
#
# `map-sources/` holds the small raw generator output (~1MB each) and IS
# tracked: those are the versioned originals worth keeping.
#
# `backgrounds/` holds the finished 3840x2160 renders, which run 5-15MB each
# as PNG and grow with every map. Media goes to the Pi by rsync, not through
# git — see deploy/README.md. Committing them would repeat the 1.08GB audio
# mistake at a slower rate.
backgrounds/
*-4k.png
*-4k.jpg

# Editor / OS cruft
.vscode/
.DS_Store
Thumbs.db
desktop.ini
tarot-audio.csv
tarot-audio.html
icon-manifest.csv
icon-manifest.html
