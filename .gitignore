# Python bytecode cache — regenerated automatically on every run, never commit
__pycache__/
*.py[cod]

# Virtual environments — recreated from requirements, not shared between machines
.venv/
venv/
env/

# Audio assets — deliberately kept out of git.
# Large binaries can't be diffed or compressed, and every version is stored
# forever, so they bloat the repo permanently (this repo was ~1GB before).
# Master copies live outside the repo; sync to the Pi with rsync over SSH.
# If you ever genuinely need one tracked: git add -f <file>
*.wav
*.ogg
*.mp3
*.flac

# Editor / OS cruft
.vscode/
.DS_Store
Thumbs.db
desktop.ini
